# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/pharmama"

# Signing key for the auth JWTs. Required: the app refuses to boot without it.
# Changing this invalidates every token already issued.
JWT_SECRET="replace-me-with-a-long-random-string"

# Optional: defaults to 3000, which collides with the Next.js dev server.
PORT=4000
